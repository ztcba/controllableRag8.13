# Environment variables
# 绝对、绝对、绝对不要上传包含你API密钥的.env文件！
.env

# Python cache
# 这些是Python自动生成的缓存文件，每个人的机器上都会重新生成
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE and editor specific files
# 忽略各种编辑器和IDE的配置文件
.idea/
.vscode/
*.swp
*~

# Virtual environment
# 虚拟环境文件夹，非常大且每个机器都应独立创建
rag_env_0714/
venv/
env/
.venv/

# Jupyter Notebook checkpoints
# Notebook运行时产生的临时检查点
.ipynb_checkpoints/

# Vector store backup
# 我们之前做的备份目录，不需要上传
vector_stores_backup/

# OS-specific files
# 忽略操作系统自动生成的文件
.DS_Store
Thumbs.db