# This is an example configuration file for environment variables used in the document retrieval system.

# API key for accessing the OpenAI services
OPENAI_API_KEY=your_openai_api_key_here

# Base URL for the OpenAI API
LLM_BASE_URL=https://api.openai.com/v1

# Model names for chat and embedding
CHAT_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002

# Default parameters for the models
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=150

# Path to the FAISS vector store
VECTOR_STORE_PATH=./data/processed/vector_store.faiss

# Path to the directory containing Markdown documents
DATA_PATH=./data/raw/markdown_documents